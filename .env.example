# Copy to .env and fill in. Never commit .env.

PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/azakana

# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Public URL of this server (Meta redirects owners here after "Connect"). Add
#   <PUBLIC_URL>/oauth/instagram/callback  and  <PUBLIC_URL>/oauth/facebook/callback
# as valid OAuth redirect URIs in the Meta app.
PUBLIC_URL=https://your-app.onrender.com

# Meta app (developers.facebook.com > your app). Facebook Login + Messenger:
META_APP_ID=
META_APP_SECRET=
# Instagram > API setup with Instagram login: the Instagram app id / secret (different from the above)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
META_VERIFY_TOKEN=pick-any-random-string
INSTAGRAM_GRAPH_URL=https://graph.instagram.com
INSTAGRAM_API_VERSION=v24.0
FACEBOOK_GRAPH_URL=https://graph.facebook.com
FACEBOOK_API_VERSION=v24.0

# Gemini (aistudio.google.com). Test Flash-Lite vs Flash on Tunisian dialect before choosing.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# WhatsApp Cloud API: owner notifications from Azakana's own number (templates azk_new_order, azk_attention)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_LANG=fr

# Telegram bot for owner notifications and your own alerts (@BotFather)
TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_CHAT_ID=
